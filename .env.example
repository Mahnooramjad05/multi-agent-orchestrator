# Copy this file to .env and fill in real values. Never commit .env.
# If no key is set for the selected provider (or LLM_PROVIDER is left
# unset), the project automatically falls back to a deterministic mock LLM
# client so it can still run and be tested with zero API keys.

# Which provider to use: "openai" or "anthropic". Leave blank/unset for mock mode.
LLM_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Qdrant vector store. Leave blank to use qdrant-client's local in-memory
# mode (location=":memory:") -- no external server required. Set this to a
# real Qdrant deployment URL (e.g. http://localhost:6333) for production.
QDRANT_URL=

# Per-run budgets (leave blank for unlimited). 15% of each is held back so a
# run that hits its budget still synthesizes an answer.
BUDGET_MAX_TOKENS=
BUDGET_MAX_SECONDS=
# Per-request timeout for real LLM providers, in seconds (default 60).
LLM_REQUEST_TIMEOUT=

# Optional: persist completed worker attempts (idempotency keys) to SQLite.
IDEMPOTENCY_DB=
# Optional: where run_goal() appends episodic log entries (default data/episodic_log.jsonl).
EPISODIC_LOG_PATH=
# Optional: fitted confidence calibration (default data/calibration.json; see python -m eval.calibrate).
CALIBRATION_PATH=
